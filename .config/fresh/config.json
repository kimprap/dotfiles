{
  "active_keybinding_map": "macos-gui",
  "theme": "cursor-dark.json",
  "editor": {
    "viewport_edge_fade": false,
    "line_wrap": false,
    "cursor_style": "blinking_bar",
    // Settings-category glyphs. Per-file explorer icons live in init.ts.
    "nerd_font_icons": true,
    // Innermost active indent block only; bracket highlighting is separate.
    "indentation_guide": "active",
    "whitespace_spaces_leading": true,
    "whitespace_spaces_inner": true,
    "whitespace_spaces_trailing": true,
    // Tab-switch slides (editor and dock terminal tabs) and other motion.
    "animations": false,
    "rulers": [88, 120],
    "trim_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    "tab_size": 2,
    "status_bar": {
      "left": ["{trust}", "{remote}", "{git_statusbar:branch}", "{diagnostics}", "{messages}", "{terminal_restart}"],
      "right": ["{cursor-status:cursor_total}", "{cursor_count}", "{read_only}", "{language}", "{lsp}", "{warnings}"],
      "separator": " "
    }
  },
  "plugins": {
    "welcome_screen": {
      "settings": { "showOnStartup": false }
    }
  },
  "file_explorer": {
    "show_hidden": true,
    // .agents is a dotfile and usually gitignored; both filters must be off to see it.
    "show_gitignored": true,
    "tree_indicator_collapsed": "\uf07b",
    "tree_indicator_expanded": "\uf07c",
    "preview_tabs": true
  },
  "file_browser": {
    "show_hidden": true
  },
  // Filename overrides replace the built-in list; retain shell defaults with *.env.
  "languages": {
    "python": { "tab_size": 4 },
    "json": { "tab_size": 4, "format_on_save": true, "comment_prefix": "//" },
    "jsonc": { "tab_size": 4 },
    "yaml": { "tab_size": 2 },
    "rust": { "tab_size": 4 },
    "javascript": { "tab_size": 4 },
    "typescript": { "tab_size": 4 },
    "makefile": { "tab_size": 8, "use_tabs": true },
    "bash": {
      "filenames": [
        ".bashrc",
        ".bash_profile",
        ".bash_aliases",
        ".bash_logout",
        ".profile",
        ".zshrc",
        ".zprofile",
        ".zshenv",
        ".zlogin",
        ".zlogout",
        "*.env"
      ]
    }
  },
  "lsp": {
    "python": {
      "command": "basedpyright-langserver",
      "args": ["--stdio"],
      "enabled": true,
      "auto_start": true,
      "root_markers": ["pyproject.toml", "setup.py", "setup.cfg", "pyrightconfig.json", ".git"]
    }
  },
  // Cmd is Fresh Super.
  // Shifted punctuation: bind both the physical key+Shift and the glyph Fresh may receive.
  "keybindings": [
    // macos-gui maps Cmd+P to unified quick_open (the tools popup).
    {"key": "p", "modifiers": ["super"], "action": "quick_open_files", "when": "global"},
    {"key": "p", "modifiers": ["super", "shift"], "action": "command_palette", "when": "global"},
    {"key": "f", "modifiers": ["shift", "super"], "action": "open_live_grep", "when": "global"},
    {"key": "\\", "modifiers": ["super"], "action": "split_vertical", "when": "normal"},
    // focus_file_explorer also reveals/selects the active file in the tree.
    {"key": "\\", "modifiers": ["shift", "super"], "action": "focus_file_explorer", "when": "global"},
    {"key": "|", "modifiers": ["super"], "action": "focus_file_explorer", "when": "global"},
    {"key": "|", "modifiers": ["shift", "super"], "action": "focus_file_explorer", "when": "global"},
    {"key": "c", "modifiers": ["ctrl", "shift"], "action": "file_explorer_copy_full_path", "when": "file_explorer"},
    {"key": "y", "modifiers": ["super"], "action": "redo", "when": "normal"},
    {"key": "d", "modifiers": ["ctrl"], "action": "duplicate_line", "when": "normal"},
    // Cursor Opt+Shift+Up copies below; Opt+Shift+Down copies above.
    {"key": "Up", "modifiers": ["alt", "shift"], "action": "duplicateLinesBelow", "when": "normal"},
    {"key": "Down", "modifiers": ["alt", "shift"], "action": "duplicateLinesAbove", "when": "normal"},
    // alt+z toggles wrap; ctrl+z stays default undo.
    {"key": "z", "modifiers": ["alt"], "action": "toggle_line_wrap", "when": "normal"},
    // Keep native search navigation; init.ts colors the exact current match.
    {"key": "g", "modifiers": ["super"], "action": "stepSearchNext", "when": "searchPrompt"},
    {"key": "g", "modifiers": ["super", "shift"], "action": "stepSearchPrev", "when": "searchPrompt"},
    {"key": "g", "modifiers": ["super"], "action": "stepSearchNext", "when": "normal"},
    {"key": "g", "modifiers": ["super", "shift"], "action": "stepSearchPrev", "when": "normal"},
    {"key": "F3", "modifiers": [], "action": "stepSearchNext", "when": "normal"},
    {"key": "F3", "modifiers": ["shift"], "action": "stepSearchPrev", "when": "normal"},
    {"key": "F3", "modifiers": [], "action": "stepSearchNext", "when": "searchPrompt"},
    {"key": "F3", "modifiers": ["shift"], "action": "stepSearchPrev", "when": "searchPrompt"},
    {"key": "Backspace", "modifiers": ["alt"], "action": "delete_word_backward", "when": "normal"},
    {"key": "Backspace", "modifiers": ["alt"], "action": "prompt_delete_word_backward", "when": "prompt"},
    // Native vertical movement leaves a single selection anchored at document edges.
    {"key": "Up", "modifiers": [], "action": "moveUpClearingBoundarySelection", "when": "normal"},
    {"key": "Down", "modifiers": [], "action": "moveDownClearingBoundarySelection", "when": "normal"},
    // Repeat native Cmd+Up/Down bindings so removing Ghostty's binding is enough.
    {"key": "Up", "modifiers": ["super"], "action": "move_document_start", "when": "normal"},
    {"key": "Down", "modifiers": ["super"], "action": "move_document_end", "when": "normal"},
    {"key": "Up", "modifiers": ["super", "shift"], "action": "select_document_start", "when": "normal"},
    {"key": "Down", "modifiers": ["super", "shift"], "action": "select_document_end", "when": "normal"},
    // Cursor Cmd+Left is smart Home, not absolute column 0.
    {"key": "Left", "modifiers": ["super"], "action": "smart_home", "when": "normal"},
    // Repeat native Cmd+/ so Ghostty unbind is enough; caret stays on the source character.
    {"key": "/", "modifiers": ["super"], "action": "toggleCommentPreserveCursor", "when": "normal"},
    {"key": "c", "modifiers": ["shift", "super"], "action": "open_terminal_in_dock", "when": "global"},
    // Directional focus cycles splits; explorer macros also restore editor focus.
    {"key": "l", "modifiers": ["shift", "super"], "action": "next_split", "when": "global"},
    {"key": "l", "modifiers": ["shift", "super"], "action": "play_macro", "args": {"char": "n"}, "when": "file_explorer"},
    {"key": "j", "modifiers": ["shift", "super"], "action": "prev_split", "when": "global"},
    {"key": "j", "modifiers": ["shift", "super"], "action": "play_macro", "args": {"char": "p"}, "when": "file_explorer"},
    {"key": "i", "modifiers": ["shift", "super"], "action": "prev_split", "when": "global"},
    {"key": "i", "modifiers": ["shift", "super"], "action": "play_macro", "args": {"char": "p"}, "when": "file_explorer"},
    {"key": "k", "modifiers": ["shift", "super"], "action": "next_split", "when": "global"},
    {"key": "k", "modifiers": ["shift", "super"], "action": "play_macro", "args": {"char": "n"}, "when": "file_explorer"},
    {"key": "j", "modifiers": ["super"], "action": "focusIntegratedTerminal", "when": "global"},
    // Terminal resize changes the active split ratio.
    {"key": "k", "modifiers": ["ctrl", "shift", "super"], "action": "decrease_split_size", "when": "terminal"},
    {"key": "j", "modifiers": ["ctrl", "shift", "super"], "action": "decrease_split_size", "when": "terminal"},
    {"key": "l", "modifiers": ["ctrl", "shift", "super"], "action": "increase_split_size", "when": "terminal"},
    {"key": "i", "modifiers": ["ctrl", "shift", "super"], "action": "increase_split_size", "when": "terminal"},
    {"key": "]", "modifiers": ["shift", "super"], "action": "next_buffer", "when": "global"},
    {"key": "}", "modifiers": ["super"], "action": "next_buffer", "when": "global"},
    {"key": "}", "modifiers": ["shift", "super"], "action": "next_buffer", "when": "global"},
    {"key": "tab", "modifiers": ["ctrl"], "action": "next_buffer", "when": "normal"},
    {"key": "[", "modifiers": ["shift", "super"], "action": "prev_buffer", "when": "global"},
    {"key": "{", "modifiers": ["super"], "action": "prev_buffer", "when": "global"},
    {"key": "{", "modifiers": ["shift", "super"], "action": "prev_buffer", "when": "global"},
    {"key": "tab", "modifiers": ["ctrl", "shift"], "action": "prev_buffer", "when": "normal"},
    {"key": "i", "modifiers": ["alt", "super"], "action": "add_cursors_to_line_ends", "when": "normal"},
    {"key": "tab", "modifiers": ["ctrl", "super"], "action": "quick_open_buffers", "when": "global"},
    {"key": "k", "modifiers": ["ctrl", "shift"], "action": "toggle_maximize_split", "when": "normal"},
    {"key": "e", "modifiers": ["shift", "super"], "action": "focus_file_explorer", "when": "global"},
    // Editor plugin modes do not inherit normal chord bindings, so file commands share global with review.
    {"keys": [{"key": "r", "modifiers": ["super"]}, {"key": "d", "modifiers": []}], "action": "side_by_side_diff_current_file", "when": "global"},
    {"keys": [{"key": "r", "modifiers": ["super"]}, {"key": "d", "modifiers": ["super"]}], "action": "side_by_side_diff_current_file", "when": "global"},
    {"keys": [{"key": "r", "modifiers": ["super"]}, {"key": "d", "modifiers": ["shift", "super"]}], "action": "start_review_diff", "when": "global"},
    {"keys": [{"key": "r", "modifiers": ["super"]}, {"key": "m", "modifiers": []}], "action": "set_language", "when": "global"},
    {"keys": [{"key": "r", "modifiers": ["super"]}, {"key": "m", "modifiers": ["super"]}], "action": "set_language", "when": "global"},
    {"keys": [{"key": "r", "modifiers": ["super"]}, {"key": "c", "modifiers": ["shift", "super"]}], "action": "open_terminal", "when": "normal"},
    {"keys": [{"key": "r", "modifiers": ["super"]}, {"key": "c", "modifiers": ["shift", "super"]}], "action": "open_terminal", "when": "mode:markdown-source"},
    {"key": "t", "modifiers": ["shift", "super"], "action": "reopenClosedTab", "when": "global"},
    {"key": "q", "modifiers": ["ctrl"], "action": "prompt_select_next", "when": "prompt"},
    {"key": "h", "modifiers": ["shift", "super"], "action": "prev_split", "when": "global"},
    {"key": "h", "modifiers": ["shift", "super"], "action": "play_macro", "args": {"char": "p"}, "when": "file_explorer"},
    // Cmd+Shift+D: all exact occurrences via native add_cursor_next_match.
    {"key": "d", "modifiers": ["super", "shift"], "action": "selectAllOccurrences", "when": "normal"},
    // Native Cmd+F prefills last nonempty history after an empty confirm. Wrapper
    // opens native search empty in that case; searchPrompt keeps native Enter.
    {"key": "f", "modifiers": ["super"], "action": "startSearchRespectingClear", "when": "normal"},
    // Reorder the active tab in-pane; Cmd+Shift+[ / ] stay next/prev buffer.
    {"key": "[", "modifiers": ["ctrl", "shift", "super"], "action": "move_tab_left", "when": "normal"},
    {"key": "{", "modifiers": ["ctrl", "super"], "action": "move_tab_left", "when": "normal"},
    {"key": "{", "modifiers": ["ctrl", "shift", "super"], "action": "move_tab_left", "when": "normal"},
    {"key": "]", "modifiers": ["ctrl", "shift", "super"], "action": "move_tab_right", "when": "normal"},
    {"key": "}", "modifiers": ["ctrl", "super"], "action": "move_tab_right", "when": "normal"},
    {"key": "}", "modifiers": ["ctrl", "shift", "super"], "action": "move_tab_right", "when": "normal"},
    // Cmd+Ctrl+Shift held for both keys: move the current editor tab, not terminal resize.
    {"keys": [{"key": "j", "modifiers": ["ctrl", "shift", "super"]}, {"key": "j", "modifiers": ["ctrl", "shift", "super"]}], "action": "moveEditorTabLeft", "when": "normal"},
    {"keys": [{"key": "k", "modifiers": ["ctrl", "shift", "super"]}, {"key": "k", "modifiers": ["ctrl", "shift", "super"]}], "action": "moveEditorTabDown", "when": "normal"},
    {"keys": [{"key": "l", "modifiers": ["ctrl", "shift", "super"]}, {"key": "l", "modifiers": ["ctrl", "shift", "super"]}], "action": "moveEditorTabRight", "when": "normal"},
    {"keys": [{"key": "i", "modifiers": ["ctrl", "shift", "super"]}, {"key": "i", "modifiers": ["ctrl", "shift", "super"]}], "action": "moveEditorTabUp", "when": "normal"},
    // Source-mode dispatch clears normal chord prefixes; bind the same editor
    // chords in that mode. Single keys already fall through to normal; leave
    // Markdown Enter/Tab, review panels, prompts and terminal routing intact.
    {"keys": [{"key": "j", "modifiers": ["ctrl", "shift", "super"]}, {"key": "j", "modifiers": ["ctrl", "shift", "super"]}], "action": "moveEditorTabLeft", "when": "mode:markdown-source"},
    {"keys": [{"key": "k", "modifiers": ["ctrl", "shift", "super"]}, {"key": "k", "modifiers": ["ctrl", "shift", "super"]}], "action": "moveEditorTabDown", "when": "mode:markdown-source"},
    {"keys": [{"key": "l", "modifiers": ["ctrl", "shift", "super"]}, {"key": "l", "modifiers": ["ctrl", "shift", "super"]}], "action": "moveEditorTabRight", "when": "mode:markdown-source"},
    {"keys": [{"key": "i", "modifiers": ["ctrl", "shift", "super"]}, {"key": "i", "modifiers": ["ctrl", "shift", "super"]}], "action": "moveEditorTabUp", "when": "mode:markdown-source"},
    // Cmd+Ctrl+=/- grow/shrink the active pane; native first-child actions are side-corrected in init.ts.
    {"key": "=", "modifiers": ["ctrl", "super"], "action": "growActiveEditorPane", "when": "normal"},
    {"key": "+", "modifiers": ["ctrl", "super"], "action": "growActiveEditorPane", "when": "normal"},
    {"key": "-", "modifiers": ["ctrl", "super"], "action": "shrinkActiveEditorPane", "when": "normal"},
    {"key": "_", "modifiers": ["ctrl", "super"], "action": "shrinkActiveEditorPane", "when": "normal"},
    {"key": "=", "modifiers": ["ctrl", "shift"], "action": "equalizeAllPanes", "when": "global"},
    {"key": "+", "modifiers": ["ctrl", "shift"], "action": "equalizeAllPanes", "when": "global"},
    {"key": "tab", "modifiers": ["shift"], "action": "review_focus_prev", "when": "mode:review-mode"},
    {"key": "tab", "modifiers": ["shift"], "action": "review_focus_prev", "when": "mode:review-diff"}
  ]
}
