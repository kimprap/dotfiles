+    // Same two backward selections on the Below chord, plus one-step undo.
+    let setup = vec![
+        Action::AddCursorNextMatch,
+        Action::AddCursorNextMatch,
+        Action::ClearMark,
+        Action::SelectLeft,
+        Action::SelectLeft,
+        Action::SelectLeft,
+        Action::DuplicateLine,
+    ];
+    assert_buffer_scenario(BufferScenario {
+        description: "DuplicateLine keeps two backward foo selections on the new copies".into(),
+        initial_text: "foo\nfoo\n".into(),
+        actions: setup.clone(),
+        expected_text: "foo\nfoo\nfoo\nfoo\n".into(),
+        expected_primary: CursorExpect::range(15, 12),
+        expected_extra_cursors: vec![CursorExpect::range(7, 4)],
+        expected_selection_text: Some("foo\nfoo".into()),
+        ..Default::default()
+    });
+    let mut undone = setup;
+    undone.push(Action::Undo);
+    assert_buffer_scenario(BufferScenario {
+        description: "Undo after DuplicateLine restores both backward foo selections".into(),
+        initial_text: "foo\nfoo\n".into(),
+        actions: undone,
+        expected_text: "foo\nfoo\n".into(),
+        expected_primary: CursorExpect::range(7, 4),
