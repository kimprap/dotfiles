+#[test]
+fn theorem_toggle_uncomment_caret_inside_indented_prefix_stays_on_line() {
+    // Indented prefix: caret inside "  # " lands at the prefix start; undo
+    // restores caret 5.
+    let setup = vec![
+        Action::MoveDown,
+        Action::MoveRight,
+        Action::MoveRight,
+        Action::MoveRight,
+        Action::ToggleComment,
+    ];
+    assert_buffer_scenario(BufferScenario {
+        language: Some("x.py".into()),
+        description: "Uncomment with caret inside indented '# ' keeps the caret on the source line"
+            .into(),
+        initial_text: "a\n  # foo\n".into(),
+        actions: setup.clone(),
+        expected_text: "a\n  foo\n".into(),
+        expected_primary: CursorExpect::at(4),
+        expected_extra_cursors: vec![],
+        expected_selection_text: Some("".into()),
+        ..Default::default()
+    });
+    let mut undone = setup;
+    undone.push(Action::Undo);
+    assert_buffer_scenario(BufferScenario {
+        language: Some("x.py".into()),
+        description: "Undo after uncomment-from-inside-indented-prefix restores text and caret 5"
+            .into(),
+        initial_text: "a\n  # foo\n".into(),
+        actions: undone,
+        expected_text: "a\n  # foo\n".into(),
+        expected_primary: CursorExpect::at(5),
+        expected_extra_cursors: vec![],
+        expected_selection_text: Some("".into()),
+        ..Default::default()
+    });
