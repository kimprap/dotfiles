+#[test]
+fn theorem_duplicate_line_above_keeps_backward_multi_cursor_selections() {
+    // Two backward "foo" selections: Above must keep each selection on its
+    // new copy, and one undo must restore the original carets. Subtracting
+    // bulk shift from the anchor would select the preceding newline.
+    let setup = vec![
+        Action::AddCursorNextMatch,
+        Action::AddCursorNextMatch,
+        Action::ClearMark,
+        Action::SelectLeft,
+        Action::SelectLeft,
+        Action::SelectLeft,
+        Action::DuplicateLineAbove,
+    ];
+    assert_buffer_scenario(BufferScenario {
+        description: "DuplicateLineAbove keeps two backward foo selections on the new copies"
+            .into(),
+        initial_text: "foo\nfoo\n".into(),
+        actions: setup.clone(),
+        expected_text: "foo\nfoo\nfoo\nfoo\n".into(),
+        expected_primary: CursorExpect::range(11, 8),
+        expected_extra_cursors: vec![CursorExpect::range(3, 0)],
+        expected_selection_text: Some("foo\nfoo".into()),
+        ..Default::default()
+    });
+    let mut undone = setup;
+    undone.push(Action::Undo);
+    assert_buffer_scenario(BufferScenario {
+        description: "Undo after DuplicateLineAbove restores both backward foo selections".into(),
+        initial_text: "foo\nfoo\n".into(),
+        actions: undone,
+        expected_text: "foo\nfoo\n".into(),
+        expected_primary: CursorExpect::range(7, 4),
+        expected_extra_cursors: vec![CursorExpect::range(3, 0)],
+        expected_selection_text: Some("foo\nfoo".into()),
+        ..Default::default()
+    });
+}
+
+#[test]
