+#[test]
+fn theorem_toggle_uncomment_caret_inside_prefix_stays_on_line() {
+    // A collapsed caret inside the removed "# " must land at the deletion
+    // start, not on the previous line's newline; one undo restores caret 3.
+    let setup = vec![Action::MoveDown, Action::MoveRight, Action::ToggleComment];
+    assert_buffer_scenario(BufferScenario {
+        language: Some("x.py".into()),
+        description: "Uncomment with caret inside '# ' keeps the caret on the source line".into(),
+        initial_text: "a\n# foo\n".into(),
+        actions: setup.clone(),
+        expected_text: "a\nfoo\n".into(),
+        expected_primary: CursorExpect::at(2),
+        expected_extra_cursors: vec![],
+        expected_selection_text: Some("".into()),
+        ..Default::default()
+    });
+    let mut undone = setup;
+    undone.push(Action::Undo);
+    assert_buffer_scenario(BufferScenario {
+        language: Some("x.py".into()),
+        description: "Undo after uncomment-from-inside-prefix restores text and caret 3".into(),
+        initial_text: "a\n# foo\n".into(),
+        actions: undone,
+        expected_text: "a\n# foo\n".into(),
+        expected_primary: CursorExpect::at(3),
+        expected_extra_cursors: vec![],
+        expected_selection_text: Some("".into()),
+        ..Default::default()
+    });
+}
