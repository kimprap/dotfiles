{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "lib": ["ESNext"],
        "target": "ESNext",
        "module": "Preserve",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "types": ["bun"],
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["*.js", "*.ts"]
}
