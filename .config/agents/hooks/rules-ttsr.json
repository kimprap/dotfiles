{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Bash|Read|Edit|Write|MultiEdit|Grep|Glob|ListDir|WebSearch|Task|run_terminal_command|search_replace|read_file|list_dir|grep|web_search|spawn_subagent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_WORKSPACE_ROOT:-$PWD}/.config/agents/hooks/scripts/ttsr-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
