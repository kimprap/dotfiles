# === Theme ===
theme = dark:Ghostty Default Style Dark, light:Atom One Light
# theme = dark:Sonokai, light:Atom One Light
# theme = dark:Everforest Dark Hard, light:Atom One Light
# theme = dark:Kanagawabones, light:Atom One Light
# theme = dark:One Dark Two, light:Atom One Light
# theme = dark:Everblush, light:Atom One Light


# === General ===
font-family = "SauceCodePro Nerd Font"
# font-family = JetBrains Mono

font-size = 14
font-thicken = true
# bold-is-bright = true

macos-option-as-alt = true
mouse-scroll-multiplier = precision:3
# background-opacity = 0.92
shell-integration-features = ssh-terminfo,ssh-env


# === Splits / Panes ===
# Stronger visual distinction for the active pane (default dimming is subtle with dense text).
unfocused-split-opacity = 0.5
unfocused-split-fill = #1e1e2e
split-divider-color = #7f849c


# === keymaps ===
keybind = cmd+k=text:clear\r

# Font zoom controls (Cmd+0 resets to your configured font-size)
keybind = cmd+0=reset_font_size


# === Cursor shaders ===
# cursor_sweep (tuned) from https://github.com/sahaj-b/ghostty-cursor-shaders
custom-shader = ~/.config/ghostty/shaders/cursor_sweep.glsl
custom-shader-animation = always

