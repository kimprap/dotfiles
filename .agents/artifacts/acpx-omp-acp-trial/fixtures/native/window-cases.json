{
  "note": "Independently authored A1 closure expectations for one request window (spec native-result contract). Ops: start=turn_started R; tool=tool_call; upd=tool_call_update; end=turn_result R; foreign=message of another request; null=message without requestId; dup=replay previous cursor. Yield input keys default to [data].",
  "cases": [
    { "name": "valid first candidate", "kind": "probe-reuse", "ops": [{ "op": "start" }, { "op": "tool", "id": "y1", "kind": "other" }, { "op": "upd", "id": "y1", "status": "completed", "detailsStatus": "success", "data": { "kind": "probe-reuse", "token": "T" } }, { "op": "end", "status": "completed" }], "expect": { "row": "candidate-valid", "c4": false } },
    { "name": "invalid first candidate is C4", "kind": "probe-reuse", "ops": [{ "op": "start" }, { "op": "tool", "id": "y1", "kind": "other" }, { "op": "upd", "id": "y1", "status": "completed", "detailsStatus": "success", "data": { "kind": "probe-reuse" } }, { "op": "end", "status": "completed" }], "expect": { "row": "candidate-invalid", "c4": true } },
    { "name": "first candidate wins over later valid", "kind": "probe-reuse", "ops": [{ "op": "start" }, { "op": "tool", "id": "y1", "kind": "other" }, { "op": "upd", "id": "y1", "status": "completed", "detailsStatus": "success", "data": { "kind": "probe-reuse", "token": "" } }, { "op": "tool", "id": "y2", "kind": "other" }, { "op": "upd", "id": "y2", "status": "completed", "detailsStatus": "success", "data": { "kind": "probe-reuse", "token": "T" } }, { "op": "end", "status": "completed" }], "expect": { "row": "candidate-invalid", "c4": true } },
    { "name": "completed without result is C4", "kind": "probe-short", "ops": [{ "op": "start" }, { "op": "tool", "id": "r1", "kind": "read", "input": { "path": "x" } }, { "op": "upd", "id": "r1", "status": "completed", "detailsStatus": "success", "data": { "kind": "probe-short", "sentence": "s" } }, { "op": "end", "status": "completed" }], "expect": { "row": "completed-no-result", "c4": true } },
    { "name": "unfinished yield is delivery-uncertain", "kind": "probe-short", "ops": [{ "op": "start" }, { "op": "tool", "id": "y1", "kind": "other" }, { "op": "end", "status": "completed" }], "expect": { "row": "delivery-uncertain", "c4": false } },
    { "name": "controller cancel precedes C4", "kind": "probe-short", "control": { "cancelled": true }, "ops": [{ "op": "start" }, { "op": "end", "status": "cancelled" }], "expect": { "row": "controller-stop", "c4": false } },
    { "name": "retained result survives later turn failure", "kind": "probe-short", "ops": [{ "op": "start" }, { "op": "tool", "id": "y1", "kind": "other" }, { "op": "upd", "id": "y1", "status": "completed", "detailsStatus": "success", "data": { "kind": "Probe_Short", "sentence": "ok" } }, { "op": "end", "status": "failed" }], "expect": { "row": "candidate-valid", "c4": false } },
    { "name": "missing turn_result leaves window unavailable", "kind": "probe-short", "ops": [{ "op": "start" }, { "op": "tool", "id": "y1", "kind": "other" }, { "op": "upd", "id": "y1", "status": "completed", "detailsStatus": "success", "data": { "kind": "probe-short", "sentence": "ok" } }], "expect": { "row": "window-unavailable", "c4": false } },
    { "name": "failed turn without result", "kind": "probe-short", "ops": [{ "op": "start" }, { "op": "end", "status": "failed" }], "expect": { "row": "turn-not-completed", "c4": false } },
    { "name": "array type is not a candidate", "kind": "probe-short", "ops": [{ "op": "start" }, { "op": "tool", "id": "y1", "kind": "other", "keys": ["data", "type"], "typeIsArray": true }, { "op": "upd", "id": "y1", "status": "completed", "detailsStatus": "success", "data": { "kind": "probe-short", "sentence": "ok" } }, { "op": "end", "status": "completed" }], "expect": { "row": "completed-no-result", "c4": true } },
    { "name": "error-status yield is not a candidate", "kind": "probe-short", "ops": [{ "op": "start" }, { "op": "tool", "id": "y1", "kind": "other" }, { "op": "upd", "id": "y1", "status": "completed", "detailsStatus": "error" }, { "op": "end", "status": "completed" }], "expect": { "row": "completed-no-result", "c4": true } },
    { "name": "undeclared input key breaks the signature", "kind": "probe-short", "ops": [{ "op": "start" }, { "op": "tool", "id": "y1", "kind": "other", "keys": ["data", "command"] }, { "op": "upd", "id": "y1", "status": "completed", "detailsStatus": "success", "data": { "kind": "probe-short", "sentence": "ok" } }, { "op": "end", "status": "completed" }], "expect": { "row": "completed-no-result", "c4": true } },
    { "name": "duplicate cursor and foreign traffic do not change ownership", "kind": "probe-reuse", "ops": [{ "op": "start" }, { "op": "null" }, { "op": "foreign", "rid": "OTHER" }, { "op": "tool", "id": "y1", "kind": "other" }, { "op": "dup" }, { "op": "upd", "id": "y1", "status": "completed", "detailsStatus": "success", "data": { "kind": "probe-reuse", "token": "T" } }, { "op": "dup" }, { "op": "end", "status": "completed" }], "expect": { "row": "candidate-valid", "c4": false, "duplicateCursorCount": 2, "unknownRequestIds": ["OTHER"] } }
  ]
}
