.DS_Store
.config/zsh/plugins.zsh
.config/nvim/nvim-pack-lock.json
.config/nvim/lazy-lock.json
.config/yazi/package.toml
.config/yazi/.yazi/

# Local env files may contain plaintext secrets.
**/.env
**/.env.*

# Karabiner writes backups/assets next to karabiner.json.
.config/karabiner/*
!.config/karabiner/
!.config/karabiner/karabiner.json
!.config/karabiner/open-app

# Herdr writes logs/session state next to config.toml.
.config/herdr/*
!.config/herdr/
!.config/herdr/config.toml
!.config/herdr/bin/
!.config/herdr/bin/numbered-panes

# Python caches (generated when running hook scripts, skills, etc.)
__pycache__/
*.py[cod]
*$py.class

# OMP Mnemopi per-project banks (machine-local SQLite; created under cwd when scoping is per-project*)
banks/
