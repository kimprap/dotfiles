#!/usr/bin/env bun
/**
 * Copy one session-local OMP plan snapshot into repository-owned plan storage.
 * Parser-invalid bytes never reach an active or archived target. The source is
 * never changed.
 *
 * Usage:
 *   omp-copy-plan-artifact copy --protocol plan-artifact-copy/v1 --slug <slug> --content-file <path>
 */

import { createHash, randomUUID } from "node:crypto";
import { constants } from "node:fs";
import { link, lstat, mkdir, mkdtemp, open, realpath, rename, rm } from "node:fs/promises";
import { basename, dirname, isAbsolute, join, relative } from "node:path";
import { tmpdir } from "node:os";

const SLUG_PATTERN = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
const COPY_PROTOCOL = "plan-artifact-copy/v1";
const LIFECYCLE_STATUSES = new Set(["PENDING", "IN_PROGRESS", "DONE", "CLOSED"]);
const TERMINAL_STATUSES = new Set(["DONE", "CLOSED"]);
const HELPER_ROOT = dirname(dirname(import.meta.path));
const PARSER = join(HELPER_ROOT, ".config", "agents", "skills", "dev-implementation", "scripts", "executor_plan.py");

class PlanArtifactError extends Error {
    constructor(message, exitCode = 1, diagnostic = undefined) {
        super(message);
        this.name = "PlanArtifactError";
        this.exitCode = exitCode;
        this.diagnostic = diagnostic;
    }
}

class SafeDiagnosticError extends Error {
    constructor(message) {
        super(message);
        this.name = "SafeDiagnosticError";
    }
}

function operationError(kind, plan, state, path, effect, message, exitCode = 1) {
    return new PlanArtifactError(message, exitCode, { kind, plan, state, path, effect });
}

function safeFailure(message) {
    return new SafeDiagnosticError(message);
}

function safeReason(error, fallback) {
    return error instanceof SafeDiagnosticError ? error.message : fallback;
}

function usage() {
    return `Usage: omp-copy-plan-artifact copy --protocol ${COPY_PROTOCOL} --slug <slug> --content-file <path>`;
}

function parseArguments(argv) {
    const [operation, ...rest] = argv;
    if (operation === "--help" || operation === "-h") {
        console.log(usage());
        process.exit(0);
    }
    if (operation !== "copy") {
        throw new PlanArtifactError("unsupported operation", 2);
    }

    let slug;
    let contentFile;
    let protocol;
    for (let index = 0; index < rest.length; index += 1) {
        const argument = rest[index];
        if (argument !== "--protocol" && argument !== "--slug" && argument !== "--content-file") {
            throw new PlanArtifactError("unknown argument", 2);
        }
        const value = rest[index + 1];
        if (!value || value.startsWith("--")) {
            throw new PlanArtifactError(`${argument} requires a value`, 2);
        }
        index += 1;
        if (argument === "--protocol") {
            if (protocol !== undefined) throw new PlanArtifactError("--protocol may be provided only once", 2);
            protocol = value;
        } else if (argument === "--slug") {
            if (slug !== undefined) throw new PlanArtifactError("--slug may be provided only once", 2);
            slug = value;
        } else {
            if (contentFile !== undefined) {
                throw new PlanArtifactError("--content-file may be provided only once", 2);
            }
            contentFile = value;
        }
    }

    if (!slug || !contentFile) {
        throw new PlanArtifactError("--slug and --content-file are required", 2);
    }
    if (!SLUG_PATTERN.test(slug)) {
        throw new PlanArtifactError("slug must be canonical lowercase kebab-case", 2);
    }
    if (!isAbsolute(contentFile)) {
        throw new PlanArtifactError("--content-file must be an absolute path", 2);
    }

    if (protocol !== COPY_PROTOCOL) {
        throw operationError(
            "PLAN_SYNC_PROTOCOL_MISMATCH",
            slug,
            "protocol-unsupported",
            "none",
            "none",
            "helper wire protocol is not supported by this generation",
            2
        );
    }
    return { slug, contentFile };
}

function sha256(bytes) {
    return createHash("sha256").update(bytes).digest("hex");
}

function statIdentity(value) {
    return `${value.dev}:${value.ino}:${value.mode}:${value.size}:${value.mtimeMs}:${value.ctimeMs}`;
}

function isSafeRegular(value) {
    return value.isFile() && !value.isSymbolicLink();
}

async function readOpenedRegular(filePath, before) {
    let handle;
    try {
        handle = await open(filePath, constants.O_RDONLY | (constants.O_NOFOLLOW ?? 0));
        const opened = await handle.stat();
        if (!isSafeRegular(opened) || statIdentity(opened) !== statIdentity(before)) {
            throw safeFailure("regular file identity changed before its verified read");
        }
        const bytes = await handle.readFile();
        const afterRead = await handle.stat();
        const afterPath = await lstat(filePath);
        if (
            !isSafeRegular(afterRead) ||
            !isSafeRegular(afterPath) ||
            statIdentity(afterRead) !== statIdentity(opened) ||
            statIdentity(afterPath) !== statIdentity(opened)
        ) {
            throw safeFailure("regular file identity changed during its verified read");
        }
        return { bytes, identity: statIdentity(afterPath) };
    } catch (error) {
        if (error instanceof SafeDiagnosticError) throw error;
        throw safeFailure("regular file could not be read through a verified descriptor");
    } finally {
        await handle?.close().catch(() => {});
    }
}

async function captureSource(contentFile, plan) {
    let sourceStat;
    try {
        sourceStat = await lstat(contentFile);
        if (!isSafeRegular(sourceStat)) {
            throw safeFailure("source must be a regular non-symlink file");
        }
        return await readOpenedRegular(contentFile, sourceStat);
    } catch (error) {
        throw operationError(
            "PLAN_FILE_KIND_UNSAFE",
            plan,
            "source-unsafe",
            "none",
            "none",
            safeReason(error, "source could not be established as a readable regular non-symlink file")
        );
    }
}

async function assertSourceCurrent(contentFile, captured, plan, effect = "none") {
    let current;
    try {
        current = await captureSource(contentFile, plan);
    } catch (error) {
        throw operationError(
            "PLAN_SOURCE_STALE",
            plan,
            "source-unreadable",
            "none",
            effect,
            "source could not be re-read safely"
        );
    }
    if (current.identity !== captured.identity || !current.bytes.equals(captured.bytes)) {
        throw operationError(
            "PLAN_SOURCE_STALE",
            plan,
            "source-changed",
            "none",
            effect,
            "source identity or bytes changed after the snapshot was captured"
        );
    }
}

async function lstatOrAbsent(filePath) {
    try {
        return await lstat(filePath);
    } catch (error) {
        if (error?.code === "ENOENT") return undefined;
        throw error;
    }
}

async function ensureSafeDirectory(root, segments, plan) {
    let current = root;
    for (const segment of segments) {
        current = join(current, segment);
        let currentStat;
        try {
            currentStat = await lstatOrAbsent(current);
            if (!currentStat) {
                try {
                    await mkdir(current);
                } catch (error) {
                    if (error?.code !== "EEXIST") throw error;
                }
                currentStat = await lstat(current);
            }
        } catch (error) {
            throw operationError(
                "PLAN_FILE_KIND_UNSAFE",
                plan,
                "storage-unsafe",
                relative(root, current) || "none",
                "none",
                "repository plan storage could not be established safely"
            );
        }
        if (!currentStat.isDirectory() || currentStat.isSymbolicLink()) {
            throw operationError(
                "PLAN_FILE_KIND_UNSAFE",
                plan,
                "storage-unsafe",
                relative(root, current) || "none",
                "none",
                "repository plan storage must use regular non-symlink directories"
            );
        }
    }
}

async function observeTarget(root, targetPath, plan) {
    const safePath = relative(root, targetPath);
    let before;
    try {
        before = await lstatOrAbsent(targetPath);
    } catch {
        throw operationError(
            "PLAN_FILE_KIND_UNSAFE",
            plan,
            "target-unreadable",
            safePath,
            "none",
            "plan target could not be inspected safely"
        );
    }
    if (!before) return { exists: false };
    if (!isSafeRegular(before)) {
        throw operationError(
            "PLAN_FILE_KIND_UNSAFE",
            plan,
            "target-unsafe",
            safePath,
            "none",
            "plan target must be a regular non-symlink file"
        );
    }
    try {
        const descriptor = await readOpenedRegular(targetPath, before);
        return {
            exists: true,
            identity: descriptor.identity,
            bytes: descriptor.bytes,
            digest: sha256(descriptor.bytes),
        };
    } catch (error) {
        throw operationError(
            "PLAN_TARGET_STALE",
            plan,
            "target-changed-during-read",
            safePath,
            "none",
            safeReason(error, "plan target changed while it was inspected")
        );
    }
}

function sameObservation(left, right) {
    if (left.exists !== right.exists) return false;
    if (!left.exists) return true;
    return left.identity === right.identity && left.digest === right.digest && left.bytes.equals(right.bytes);
}

async function assertTargetsCurrent(root, activePath, archivePath, observed, plan) {
    const current = {
        active: await observeTarget(root, activePath, plan),
        archive: await observeTarget(root, archivePath, plan),
    };
    if (!sameObservation(observed.active, current.active) || !sameObservation(observed.archive, current.archive)) {
        throw operationError(
            "PLAN_TARGET_STALE",
            plan,
            "target-changed",
            "none",
            "none",
            "active or archived target changed before publication"
        );
    }
    return current;
}

async function validateSnapshot(root, slug, bytes) {
    const digest = sha256(bytes);
    const temporaryRoot = await mkdtemp(join(tmpdir(), "omp-plan-artifact-"));
    const snapshotPath = join(temporaryRoot, `${slug}-plan.md`);
    let report;
    let exitCode;
    try {
        const handle = await open(
            snapshotPath,
            constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | (constants.O_NOFOLLOW ?? 0),
            0o600
        );
        try {
            await handle.writeFile(bytes);
            await handle.sync();
        } finally {
            await handle.close();
        }

        const parserStat = await lstat(PARSER);
        if (!isSafeRegular(parserStat)) throw safeFailure("shared parser is unavailable");
        const child = Bun.spawn(["python3", PARSER, "validate", snapshotPath], {
            cwd: root,
            stdout: "pipe",
            stderr: "pipe",
        });
        const [stdout, stderr, status] = await Promise.all([
            new Response(child.stdout).text(),
            new Response(child.stderr).text(),
            child.exited,
        ]);
        exitCode = status;
        if (stderr !== "") throw safeFailure("shared parser emitted an unexpected diagnostic stream");
        report = JSON.parse(stdout.trim());
    } catch (error) {
        throw operationError(
            "PLAN_ARTIFACT_INVALID",
            slug,
            "parser:UNAVAILABLE",
            "none",
            "none",
            safeReason(error, "shared parser did not return a usable validation result")
        );
    } finally {
        await rm(temporaryRoot, { recursive: true, force: true }).catch(() => {});
    }

    const firstIssue = Array.isArray(report?.issues) ? report.issues[0] : undefined;
    if (report?.status !== "valid" || exitCode !== 0) {
        const issueCode =
            typeof firstIssue?.code === "string" && /^[A-Z0-9_]+$/.test(firstIssue.code)
                ? firstIssue.code
                : "RESULT_INVALID";
        throw operationError(
            "PLAN_ARTIFACT_INVALID",
            slug,
            `parser:${issueCode}`,
            "none",
            "none",
            "plan snapshot failed shared parser validation"
        );
    }

    const lifecycleStatus = report.lifecycle_status;
    const terminalComplete = report.terminal_complete;
    const expectedTerminal = TERMINAL_STATUSES.has(lifecycleStatus);
    if (
        report.schema !== "executor-plan-validation/v1" ||
        !Array.isArray(report.issues) ||
        report.issues.length !== 0 ||
        report.plan_sha256 !== digest ||
        typeof report.datetime !== "string" ||
        !LIFECYCLE_STATUSES.has(lifecycleStatus) ||
        typeof terminalComplete !== "boolean" ||
        terminalComplete !== expectedTerminal
    ) {
        throw operationError(
            "PLAN_ARTIFACT_INVALID",
            slug,
            "parser:RESULT_INVALID",
            "none",
            "none",
            "shared parser result did not bind the exact plan snapshot"
        );
    }

    return {
        datetime: report.datetime,
        lifecycleStatus,
        terminalComplete,
        digest,
    };
}

async function stageBytes(targetPath, bytes) {
    const temporaryPath = join(dirname(targetPath), `.${basename(targetPath)}.${process.pid}.${randomUUID()}.tmp`);
    const handle = await open(
        temporaryPath,
        constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | (constants.O_NOFOLLOW ?? 0),
        0o644
    );
    try {
        await handle.writeFile(bytes);
        await handle.sync();
    } catch (error) {
        await handle.close().catch(() => {});
        await rm(temporaryPath, { force: true }).catch(() => {});
        throw error;
    }
    await handle.close();
    return temporaryPath;
}

async function publishNoOverwrite(temporaryPath, targetPath) {
    await link(temporaryPath, targetPath);
}

function requireExactTarget(observation, bytes) {
    return observation.exists && observation.bytes.equals(bytes);
}

async function copyNonterminal(root, sourcePath, source, activePath, archivePath, plan) {
    const observed = {
        active: await observeTarget(root, activePath, plan),
        archive: await observeTarget(root, archivePath, plan),
    };
    if (observed.active.exists && observed.archive.exists) {
        throw operationError(
            "PLAN_IDENTITY_CONFLICT",
            plan,
            "active-and-archive",
            "none",
            "none",
            "active and archived targets both exist for this plan identity"
        );
    }
    if (observed.archive.exists) {
        throw operationError(
            "PLAN_ARCHIVE_CONFLICT",
            plan,
            "archive-exists",
            relative(root, archivePath),
            "none",
            "a terminal archive already exists for this plan identity"
        );
    }

    let temporaryPath;
    let effectStarted = false;
    try {
        temporaryPath = await stageBytes(activePath, source.bytes);
        await assertSourceCurrent(sourcePath, source, plan);
        await assertTargetsCurrent(root, activePath, archivePath, observed, plan);
        if (observed.active.exists) {
            await rename(temporaryPath, activePath);
            effectStarted = true;
            temporaryPath = undefined;
        } else {
            await publishNoOverwrite(temporaryPath, activePath);
            effectStarted = true;
            await rm(temporaryPath);
            temporaryPath = undefined;
        }

        const active = await observeTarget(root, activePath, plan);
        const archive = await observeTarget(root, archivePath, plan);
        if (!requireExactTarget(active, source.bytes) || archive.exists) {
            throw safeFailure("active target did not retain the exact validated snapshot");
        }
        await assertSourceCurrent(sourcePath, source, plan, "possible-complete");
        return `plan-artifact-copied: ${relative(root, activePath)}`;
    } catch (error) {
        if (effectStarted) {
            throw operationError(
                "PLAN_POSTCONDITION_FAILED",
                plan,
                "postcondition-uncertain",
                relative(root, activePath),
                "possible-complete",
                safeReason(error, "active target postcondition could not be established")
            );
        }
        if (error instanceof PlanArtifactError) throw error;
        throw operationError(
            error?.code === "EEXIST" ? "PLAN_TARGET_STALE" : "PLAN_FILE_KIND_UNSAFE",
            plan,
            error?.code === "EEXIST" ? "target-appeared" : "publication-failed",
            relative(root, activePath),
            "none",
            "active target could not be published safely"
        );
    } finally {
        if (temporaryPath) await rm(temporaryPath, { force: true }).catch(() => {});
    }
}

async function copyTerminal(root, sourcePath, source, activePath, archivePath, plan) {
    const observed = {
        active: await observeTarget(root, activePath, plan),
        archive: await observeTarget(root, archivePath, plan),
    };
    if (observed.active.exists && observed.archive.exists) {
        throw operationError(
            "PLAN_IDENTITY_CONFLICT",
            plan,
            "active-and-archive",
            "none",
            "none",
            "active and archived targets both exist for this plan identity"
        );
    }
    if (observed.archive.exists) {
        if (!observed.archive.bytes.equals(source.bytes)) {
            throw operationError(
                "PLAN_ARCHIVE_CONFLICT",
                plan,
                "archive-divergent",
                relative(root, archivePath),
                "none",
                "existing archive differs from the validated terminal snapshot"
            );
        }
        await assertSourceCurrent(sourcePath, source, plan);
        const confirmedArchive = await observeTarget(root, archivePath, plan);
        const confirmedActive = await observeTarget(root, activePath, plan);
        if (!requireExactTarget(confirmedArchive, source.bytes) || confirmedActive.exists) {
            throw operationError(
                "PLAN_TARGET_STALE",
                plan,
                "archive-changed",
                relative(root, archivePath),
                "none",
                "existing archive changed before its postcondition was confirmed"
            );
        }
        return `plan-artifact-archived: ${relative(root, archivePath)}`;
    }

    let temporaryPath;
    let effectStarted = false;
    try {
        temporaryPath = await stageBytes(archivePath, source.bytes);
        await assertSourceCurrent(sourcePath, source, plan);
        await assertTargetsCurrent(root, activePath, archivePath, observed, plan);
        await publishNoOverwrite(temporaryPath, archivePath);
        effectStarted = true;
        await rm(temporaryPath);
        temporaryPath = undefined;

        const archived = await observeTarget(root, archivePath, plan);
        if (!requireExactTarget(archived, source.bytes)) {
            throw safeFailure("archive did not retain the exact validated snapshot");
        }
        if (observed.active.exists) {
            const active = await observeTarget(root, activePath, plan);
            if (!sameObservation(observed.active, active)) {
                throw safeFailure("active target changed before terminal removal");
            }
            await rm(activePath);
        }

        const finalActive = await observeTarget(root, activePath, plan);
        const finalArchive = await observeTarget(root, archivePath, plan);
        if (finalActive.exists || !requireExactTarget(finalArchive, source.bytes)) {
            throw safeFailure("terminal archive postcondition could not be confirmed");
        }
        await assertSourceCurrent(sourcePath, source, plan, "possible-complete");
        return `plan-artifact-archived: ${relative(root, archivePath)}`;
    } catch (error) {
        if (effectStarted) {
            throw operationError(
                "PLAN_POSTCONDITION_FAILED",
                plan,
                "postcondition-uncertain",
                relative(root, archivePath),
                "possible-complete",
                safeReason(error, "terminal archive postcondition could not be established")
            );
        }
        if (error instanceof PlanArtifactError) throw error;
        throw operationError(
            error?.code === "EEXIST" ? "PLAN_TARGET_STALE" : "PLAN_FILE_KIND_UNSAFE",
            plan,
            error?.code === "EEXIST" ? "archive-appeared" : "archive-publication-failed",
            relative(root, archivePath),
            "none",
            "terminal archive could not be created safely"
        );
    } finally {
        if (temporaryPath) await rm(temporaryPath, { force: true }).catch(() => {});
    }
}

async function copyPlan(root, slug, contentFile) {
    if (basename(contentFile) !== `${slug}-plan.md`) {
        throw operationError(
            "PLAN_IDENTITY_MISMATCH",
            slug,
            "source-basename-mismatch",
            "none",
            "none",
            `content file identity must match slug '${slug}'`
        );
    }

    const source = await captureSource(contentFile, slug);
    const validation = await validateSnapshot(root, slug, source.bytes);
    const plan = `${validation.datetime}_${slug}`;
    const activePath = join(root, ".agents", "plans", `${plan}.md`);
    const archivePath = join(root, ".agents", "plans", "archive", `${plan}.md`);

    await ensureSafeDirectory(root, [".agents"], plan);
    await ensureSafeDirectory(root, [".agents", "plans"], plan);
    if (validation.terminalComplete) {
        await ensureSafeDirectory(root, [".agents", "plans", "archive"], plan);
        return await copyTerminal(root, contentFile, source, activePath, archivePath, plan);
    }
    return await copyNonterminal(root, contentFile, source, activePath, archivePath, plan);
}

async function main() {
    const { slug, contentFile } = parseArguments(process.argv.slice(2));
    let root;
    try {
        root = await realpath(process.cwd());
        const rootStat = await lstat(root);
        if (!rootStat.isDirectory() || rootStat.isSymbolicLink()) {
            throw safeFailure("repository root must be a regular non-symlink directory");
        }
    } catch (error) {
        throw operationError(
            "PLAN_FILE_KIND_UNSAFE",
            slug,
            "repository-root-unavailable",
            "none",
            "none",
            safeReason(error, "repository root could not be established safely")
        );
    }
    console.log(await copyPlan(root, slug, contentFile));
}

if (import.meta.main) {
    main().catch((error) => {
        if (error instanceof PlanArtifactError) {
            if (error.diagnostic) {
                const { kind, plan, state, path, effect } = error.diagnostic;
                console.error(
                    `ERROR: ${kind}: plan=${plan} state=${state} path=${path} effect=${effect}: ${error.message}`
                );
            } else {
                console.error(`ERROR: ${error.message}`);
            }
            process.exit(error.exitCode);
        }
        console.error("ERROR: operation failed before a stable diagnostic was available");
        process.exit(1);
    });
}
